# GEMINI_API_KEY: Required for conversational AI. Create a key in Google AI Studio.
# For local development, put your key in .env (do not commit .env).
GEMINI_API_KEY=""

# Email that receives administrator access when the account is created.
# Configure the email that should receive administrator access on signup.
ADMIN_EMAIL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
